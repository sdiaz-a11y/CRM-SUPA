# Secreto para firmar las sesiones (JWT) del login propio del CRM. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

KAJABI_CLIENT_ID=
KAJABI_CLIENT_SECRET=
KAJABI_WEBHOOK_SECRET=
KAJABI_WEBHOOK_BASE_URL=

SKOOL_WEBHOOK_URL=

CRON_SECRET=

GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
GHL_TAG_ALTA_CRM=
# Secreto del webhook de confirmación de entrega (ver src/app/api/webhooks/ghl-bienvenida-wa)
GHL_WEBHOOK_SECRET=

HOTMART_WEBHOOK_SECRET=

# Formulario externo de VSL (ver FORMULARIO-SOLICITUDES-VSL.md):
# SOLICITUDES_EXTERNAS_TOKEN es el secreto que va en ?token= de
# /api/solicitudes-externas. SOLICITUDES_EXTERNAS_USUARIO_ID es el id (uuid)
# del usuario placeholder "VSL (externo)" en la tabla usuarios — crearlo
# desde Usuarios en el CRM (rol "abeja", inactivo) y pegar aquí su id.
SOLICITUDES_EXTERNAS_TOKEN=
SOLICITUDES_EXTERNAS_USUARIO_ID=
